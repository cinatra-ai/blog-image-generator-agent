{
  "agentspec_version": "26.1.0",
  "component_type": "Flow",
  "id": "blog-image-generator-agent-flow",
  "name": "Blog Image Generator Agent",
  "description": "Stateless leaf agent that makes the featured image of a blog post: it reads the draft post, writes the picture prompt for itself, and returns exactly one image record naming the post it belongs to and its placement. No body pictures.",
  "metadata": {
    "cinatra": {
      "type": "flow",
      "packageName": "@cinatra-ai/blog-image-generator-agent",
      "hitlScreens": [
        "@cinatra-ai/context-selection-agent:context-selector"
      ],
      "llm": {
        "preferredProvider": "openai",
        "preferredModel": "gpt-5.5"
      },
      "contextSlots": [
        {
          "slotId": "imagePromptContext",
          "acceptedArtifactExtensions": [
            "@cinatra-ai/brand-voice-artifact",
            "@cinatra-ai/blog-post-artifact"
          ],
          "selectionMode": "interactive",
          "resolutionMode": "accumulate",
          "minItems": 0,
          "maxItems": 5
        }
      ]
    }
  },
  "inputs": [
    {
      "title": "post",
      "type": "string"
    },
    {
      "title": "placement",
      "type": "string",
      "default": "featured"
    },
    {
      "title": "postArtifactId",
      "type": "string",
      "default": ""
    },
    {
      "title": "cinatra_run_id",
      "type": "string",
      "default": ""
    },
    {
      "title": "imagePromptContextParentPackageName",
      "type": "string",
      "default": "@cinatra-ai/blog-image-generator-agent"
    },
    {
      "title": "imagePromptContextSlotId",
      "type": "string",
      "default": "imagePromptContext"
    },
    {
      "title": "projectId",
      "type": "string",
      "default": ""
    }
  ],
  "outputs": [
    {
      "title": "image",
      "type": "object",
      "json_schema": {
        "type": "object",
        "properties": {
          "placement": {
            "type": "string",
            "enum": [
              "featured"
            ]
          },
          "post": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "altText": {
            "type": "string"
          }
        },
        "required": [
          "placement",
          "post",
          "prompt",
          "altText"
        ]
      }
    },
    {
      "title": "notes",
      "type": "string"
    }
  ],
