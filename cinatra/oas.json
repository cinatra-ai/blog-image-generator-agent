      "inputs": [
        {
          "title": "post",
          "type": "string"
        },
        {
          "title": "placement",
          "type": "string",
          "default": "featured"
        },
        {
          "title": "postArtifactId",
          "type": "string",
          "default": ""
        },
        {
          "title": "cinatra_run_id",
          "type": "string",
